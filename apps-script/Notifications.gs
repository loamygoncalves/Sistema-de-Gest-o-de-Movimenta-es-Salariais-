/**
 * Notificações por e-mail — enviadas via MailApp (conta Google de quem
 * está executando o Web App) para os perfis interessados. Não há
 * equivalente de credencial SMTP a configurar — MailApp usa a própria
 * conta Google autorizada no deploy (ver appsscript.json, escopo
 * script.send_mail).
 *
 * Dois eventos disparam e-mail:
 *   1. notifyMovementSubmitted_ — nova solicitação, para quem pode aprovar
 *      (Administrador, RH Remuneração, Diretor da diretoria, Gestor(es) do
 *      centro de custo).
 *   2. notifyMovementDecided_ — desfecho da solicitação (aprovada em todas
 *      as etapas, ou reprovada em qualquer etapa — o que encerra o fluxo),
 *      só para quem solicitou.
 *
 * Falha de envio nunca deve impedir a ação que a originou — por isso todo
 * disparo é protegido por try/catch (mesmo padrão de recordAudit_ em Db.gs).
 *
 * Layout compartilhado (emailShellHtml_): cabeçalho com a logo Beep e as
 * cores da marca (teal), cartão de cantos arredondados, botão de acesso ao
 * Web App e rodapé — mesmo padrão visual do restante do BEEP Remunera.
 */

var MOVEMENT_TYPE_LABELS_ = {
  PROMOCAO: 'Promoção',
  MERITO: 'Mérito',
  AUMENTO_QUADRO: 'Aumento de Quadro',
};

var APPROVER_ROLE_LABELS_ = {
  ADMIN: 'Administrador',
  RH_REMUNERACAO: 'RH Remuneração',
  DIRETOR: 'Diretor',
};

/** Mesmo asset de BEEP_LOGO_DATA_URI em Client_Core.html — duplicado aqui porque
 * um .gs (servidor) não enxerga variáveis definidas dentro de um <script> de
 * .html (executado no navegador do usuário); são contextos JS separados. */
var NOTIFICATION_LOGO_DATA_URI_ =
  'data:image/png;base64,';

/** Gmail bloqueia `<img src="data:...">` em e-mails — a logo precisa ir
 * como imagem inline referenciada por Content-ID (`cid:beeplogo`), anexada
 * via `inlineImages` no MailApp.sendEmail. */
function notificationLogoBlob_() {
  var base64 = NOTIFICATION_LOGO_DATA_URI_.split(',')[1];
  return Utilities.newBlob(Utilities.base64Decode(base64), 'image/png', 'beep-logo.png');
}

function notifyMovementSubmitted_(movement) {
  try {
    var recipients = resolveMovementNotificationRecipients_(movement);
    if (recipients.length === 0) return;

    var subject = 'BEEP Remunera — nova solicitação: ' + movementNotificationTitle_(movement);
    var body = buildMovementNotificationBody_(movement);
    var logoBlob = notificationLogoBlob_();

    recipients.forEach(function (email) {
      MailApp.sendEmail({ to: email, subject: subject, htmlBody: body, inlineImages: { beeplogo: logoBlob } });
    });
  } catch (e) {
    Logger.log('Falha ao enviar e-mails de notificação de movimentação: ' + e);
  }
}

/**
 * Notifica quem solicitou quando a movimentação é decidida — aprovada (só
 * quando TODAS as etapas do fluxo forem concluídas) ou reprovada (em
 * qualquer etapa, já que uma reprovação encerra o fluxo inteiro). Só o
 * solicitante recebe — os aprovadores já sabem, decidiram eles mesmos.
 * `decision` é MovementStatus.APROVADO ou MovementStatus.REPROVADO;
 * `decidedByUser` é o registro de Tables.users de quem decidiu (a última
 * etapa, no caso de aprovação); `comment` é opcional.
 */
function notifyMovementDecided_(movement, decision, decidedByUser, comment) {
  try {
    if (!movement.requestedByEmail) return;

    var approved = decision === MovementStatus.APROVADO;
    var subject =
      'BEEP Remunera — solicitação ' +
      (approved ? 'aprovada' : 'reprovada') +
      ': ' +
      movementNotificationTitle_(movement);
    var body = buildMovementDecisionBody_(movement, approved, decidedByUser, comment);

    MailApp.sendEmail({
      to: movement.requestedByEmail,
      subject: subject,
      htmlBody: body,
      inlineImages: { beeplogo: notificationLogoBlob_() },
    });
  } catch (e) {
    Logger.log('Falha ao enviar e-mail de decisão de movimentação: ' + e);
  }
}

/** Administrador e RH Remuneração sempre; Diretor da diretoria; Gestor(es) do centro de custo. */
function resolveMovementNotificationRecipients_(movement) {
  var emails = {};
  Tables.users
    .where(function (u) {
      return u.active;
    })
    .forEach(function (u) {
      if (u.role === UserRole.ADMIN || u.role === UserRole.RH_REMUNERACAO) {
        emails[u.email] = true;
        return;
      }
      if (u.role === UserRole.DIRETOR) {
        if (!u.directorateId || u.directorateId === movement.directorateId) emails[u.email] = true;
        return;
      }
      if (u.role === UserRole.GESTOR) {
        var ids = parseCostCenterIds_(u.costCenterIds);
        if (movement.costCenterId && ids.indexOf(movement.costCenterId) !== -1) emails[u.email] = true;
      }
    });
  return Object.keys(emails);
}

function movementNotificationTitle_(movement) {
  var typeLabel = MOVEMENT_TYPE_LABELS_[movement.type] || movement.type;
  return typeLabel + (movement.employeeName ? ' — ' + movement.employeeName : '');
}

/** "2026-09-01" ou "2026-09-01T03:00:00.000Z" -> "01/09/2026", direto da
 * string — nunca via `new Date()`: uma data-only vira meia-noite UTC e, num
 * servidor com timezone atrás de UTC, os getters locais devolveriam o dia
 * anterior (mesmo motivo do parseIsoDateParts_ em SimulatorService.gs). O
 * valor pode chegar como timestamp completo (célula de data da planilha
 * serializada) — descarta a parte do horário antes de separar os campos. */
function formatEffectiveDate_(isoDate) {
  var dateOnly = String(isoDate || '').split('T')[0];
  var parts = dateOnly.split('-');
  if (parts.length !== 3) return String(isoDate || '-');
  return parts[2] + '/' + parts[1] + '/' + parts[0];
}

/** Nome cadastrado do usuário (Tables.users) a partir do e-mail — cai para o
 * próprio e-mail se não houver cadastro correspondente. */
function resolveUserDisplayName_(email) {
  if (!email) return '-';
  var user = Tables.users.where(function (u) {
    return u.email === email;
  })[0];
  return (user && user.name) || email;
}

function formatCurrencyBRL_(value) {
  return 'R$ ' + Number(value).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function escapeHtml_(value) {
  return String(value === null || value === undefined ? '' : value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

/** URL do Web App implantado, para o botão de acesso no e-mail — string vazia se indisponível (o botão some). */
function safeWebAppUrl_() {
  try {
    return ScriptApp.getService().getUrl() || '';
  } catch (e) {
    return '';
  }
}

/** Selo colorido do tipo de movimentação — mesmo padrão visual das pills do app. */
function movementTypePillHtml_(type) {
  var label = MOVEMENT_TYPE_LABELS_[type] || type;
  return (
    '<span style="display:inline-block;background:#e3f8f7;color:#008E87;font-size:12px;font-weight:700;' +
    'padding:3px 10px;border-radius:999px;">' +
    escapeHtml_(label) +
    '</span>'
  );
}

function infoRowHtml_(label, valueHtml, isLast) {
  var border = isLast ? '' : 'border-bottom:1px solid #f1f5f9;';
  return (
    '<tr><td style="padding:10px 0;width:38%;' +
    border +
    'vertical-align:top;font-size:11px;font-weight:600;letter-spacing:.03em;color:#94a3b8;text-transform:uppercase;">' +
    escapeHtml_(label) +
    '</td><td style="padding:10px 0;' +
    border +
    'vertical-align:top;font-size:14px;font-weight:600;color:#0f172a;">' +
    valueHtml +
    '</td></tr>'
  );
}

/** Linhas de resumo da movimentação, compartilhadas entre o e-mail de nova solicitação e o de decisão. */
function movementInfoRowsHtml_(movement) {
  var rows = [];
  rows.push(['Tipo', movementTypePillHtml_(movement.type)]);
  if (movement.employeeName) rows.push(['Colaborador', escapeHtml_(movement.employeeName)]);
  if (movement.requestedByEmail) {
    rows.push(['Solicitado por', escapeHtml_(resolveUserDisplayName_(movement.requestedByEmail))]);
  }
  rows.push(['Diretoria', escapeHtml_(movement.directorateName || '-')]);
  rows.push(['Centro de resultado', escapeHtml_(movement.costCenterName || '-')]);
  if (movement.currentPositionName) rows.push(['Cargo atual', escapeHtml_(movement.currentPositionName)]);
  if (movement.newPositionName) rows.push(['Novo cargo', escapeHtml_(movement.newPositionName)]);
  if (movement.currentSalary) rows.push(['Salário atual', escapeHtml_(formatCurrencyBRL_(movement.currentSalary))]);
  if (movement.newSalary) rows.push(['Novo salário', escapeHtml_(formatCurrencyBRL_(movement.newSalary))]);
  if (movement.meritPercentage) {
    rows.push(['Percentual de mérito', escapeHtml_(Number(movement.meritPercentage).toFixed(2) + '%')]);
  }
  if (movement.quantity) rows.push(['Quantidade de vagas', escapeHtml_(movement.quantity)]);
  if (movement.plannedSalary) rows.push(['Salário planejado', escapeHtml_(formatCurrencyBRL_(movement.plannedSalary))]);
  rows.push(['Data efetiva', escapeHtml_(formatEffectiveDate_(movement.effectiveDate))]);

  return rows
    .map(function (r, i) {
      return infoRowHtml_(r[0], r[1], i === rows.length - 1);
    })
    .join('');
}

/** Bloco de texto livre destacado (justificativa ou comentário do aprovador/reprovador). */
function calloutBlockHtml_(label, text, bg, labelColor) {
  return (
    '<tr><td style="padding:22px 28px 8px 28px;">' +
    '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:' +
    bg +
    ';border-radius:8px;">' +
    '<tr><td style="padding:14px 16px;font-size:11px;font-weight:700;letter-spacing:.06em;color:' +
    labelColor +
    ';text-transform:uppercase;">' +
    escapeHtml_(label) +
    '</td></tr>' +
    '<tr><td style="padding:0 16px 14px 16px;font-size:13px;line-height:1.5;color:#334155;font-style:italic;">"' +
    escapeHtml_(text) +
    '"</td></tr>' +
    '</table></td></tr>'
  );
}

/**
 * Cartão de e-mail compartilhado: cabeçalho com logo Beep, título/eyebrow
 * coloridos por `opts.eyebrowColor` (teal por padrão; verde/vermelho nos
 * e-mails de decisão), corpo livre (`opts.bodyHtml`), botão de CTA opcional
 * e rodapé. `opts`: {eyebrow, eyebrowColor, title, intro, bodyHtml,
 * ctaLabel, ctaUrl, footerNote}.
 */
function emailShellHtml_(opts) {
  var ctaHtml = '';
  if (opts.ctaUrl) {
    ctaHtml =
      '<tr><td style="padding:26px 28px 28px 28px;" align="center">' +
      '<table role="presentation" cellpadding="0" cellspacing="0"><tr>' +
      '<td style="border-radius:8px;background:#00AFAA;">' +
      '<a href="' +
      opts.ctaUrl +
      '" style="display:inline-block;padding:12px 28px;font-size:14px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:8px;">' +
      escapeHtml_(opts.ctaLabel || 'Abrir no BEEP Remunera') +
      '</a></td></tr></table></td></tr>';
  }

  return (
    '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f1f5f9;padding:32px 16px;font-family:Arial,Helvetica,sans-serif;">' +
    '<tr><td align="center">' +
    '<table role="presentation" width="560" cellpadding="0" cellspacing="0" style="width:560px;max-width:100%;background:#ffffff;border-radius:12px;border:1px solid #e2e8f0;overflow:hidden;">' +
    '<tr><td style="padding:24px 28px 18px 28px;border-bottom:2px solid #e3f8f7;">' +
    '<table role="presentation" cellpadding="0" cellspacing="0"><tr>' +
    '<td style="padding-right:12px;vertical-align:middle;"><img src="cid:beeplogo" alt="Beep Saúde" height="34" style="display:block;height:34px;width:auto;"></td>' +
    '<td style="vertical-align:middle;line-height:1.15;">' +
    '<span style="display:block;font-size:17px;font-weight:800;letter-spacing:.02em;color:#008E87;">BEEP</span>' +
    '<span style="display:block;font-size:11px;font-weight:600;color:#64748b;margin-top:1px;">Remunera</span>' +
    '</td></tr></table></td></tr>' +
    '<tr><td style="padding:26px 28px 8px 28px;">' +
    '<p style="margin:0 0 6px 0;font-size:11px;font-weight:700;letter-spacing:.08em;color:' +
    (opts.eyebrowColor || '#00AFAA') +
    ';text-transform:uppercase;">' +
    escapeHtml_(opts.eyebrow) +
    '</p>' +
    '<h1 style="margin:0 0 6px 0;font-size:20px;line-height:1.3;color:#0f172a;font-weight:700;">' +
    opts.title +
    '</h1>' +
    '<p style="margin:0 0 20px 0;font-size:14px;line-height:1.5;color:#475569;">' +
    opts.intro +
    '</p>' +
    '</td></tr>' +
    (opts.bodyHtml || '') +
    ctaHtml +
    '<tr><td style="padding:16px 28px;background:#f8fafc;border-top:1px solid #e2e8f0;">' +
    '<p style="margin:0;font-size:11px;line-height:1.5;color:#94a3b8;">' +
    (opts.footerNote || 'Este e-mail foi enviado automaticamente pelo BEEP Remunera.') +
    '</p></td></tr>' +
    '</table></td></tr></table>'
  );
}

function buildMovementNotificationBody_(movement) {
  var bodyHtml =
    '<tr><td style="padding:0 28px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0">' +
    movementInfoRowsHtml_(movement) +
    '</table></td></tr>' +
    (movement.justification
      ? calloutBlockHtml_('Justificativa', movement.justification, '#f8fafc', '#94a3b8')
      : '');

  return emailShellHtml_({
    eyebrow: 'Nova solicitação',
    title: escapeHtml_(movementNotificationTitle_(movement)),
    intro: 'Uma nova solicitação foi submetida e aguarda aprovação. Resumo abaixo:',
    bodyHtml: bodyHtml,
    ctaLabel: 'Abrir no BEEP Remunera',
    ctaUrl: safeWebAppUrl_(),
  });
}

function buildMovementDecisionBody_(movement, approved, decidedByUser, comment) {
  var accentColor = approved ? '#1f9d6c' : '#dc2626';
  var decidedByLabel = approved ? 'Aprovado por' : 'Reprovado por';
  var decidedByName = (decidedByUser && (decidedByUser.name || decidedByUser.email)) || '-';
  var decidedByRoleLabel =
    decidedByUser && decidedByUser.role ? APPROVER_ROLE_LABELS_[decidedByUser.role] || decidedByUser.role : '';
  var decidedByValue =
    escapeHtml_(decidedByName) + (decidedByRoleLabel ? ' (' + escapeHtml_(decidedByRoleLabel) + ')' : '');

  var bodyHtml =
    '<tr><td style="padding:0 28px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0">' +
    infoRowHtml_(decidedByLabel, decidedByValue, false) +
    movementInfoRowsHtml_(movement) +
    '</table></td></tr>' +
    (comment
      ? calloutBlockHtml_(
          'Comentário',
          comment,
          approved ? '#eafbf3' : '#fef2f2',
          approved ? '#167a54' : '#b91c1c'
        )
      : '') +
    (movement.justification
      ? calloutBlockHtml_('Justificativa original', movement.justification, '#f8fafc', '#94a3b8')
      : '');

  return emailShellHtml_({
    eyebrow: approved ? 'Solicitação aprovada' : 'Solicitação reprovada',
    eyebrowColor: accentColor,
    title: escapeHtml_(movementNotificationTitle_(movement)),
    intro: approved
      ? 'Sua solicitação foi aprovada em todas as etapas do fluxo de aprovação. Resumo abaixo:'
      : 'Sua solicitação foi reprovada e o fluxo foi encerrado. Resumo abaixo:',
    bodyHtml: bodyHtml,
    ctaLabel: 'Ver movimentação',
    ctaUrl: safeWebAppUrl_(),
    footerNote: 'Este e-mail foi enviado automaticamente pelo BEEP Remunera.',
  });
}
